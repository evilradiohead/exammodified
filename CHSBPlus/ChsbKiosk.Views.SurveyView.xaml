<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ChsbKiosk.Views.SurveyView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:ChsbKiosk.Views;assembly=CHSBPlus" Loaded="OnLoaded">
  <Grid Background="{StaticResource Brush.Bg}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#FFFFFFFF" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="28,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Image Grid.Column="0" Source="/Assets/logo-mark-small.png" Width="44" Height="44" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock Name="TitleText" Style="{StaticResource Text.H2}" FontSize="20" Text="So'rovnoma" />
          <TextBlock Name="DescriptionText" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" Text="Test topshirildi. Iltimos, quyidagi savollarga javob bering — so'rovnoma baholanmaydi." />
        </StackPanel>
      </Grid>
    </Border>
    <ScrollViewer Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel MaxWidth="860" Margin="28,22">
        <TextBlock Name="StatusText" Style="{StaticResource Text.Muted}" FontSize="14" Text="So'rovnoma yuklanmoqda..." Margin="0,0,0,12" />
        <StackPanel Name="QuestionsPanel" />
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="#FFFFFFFF" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="28,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Name="ErrorText" Grid.Column="0" Style="{StaticResource Text.Base}" FontWeight="Medium" Foreground="{StaticResource Brush.DangerInk}" VerticalAlignment="Center" Margin="0,0,16,0" />
        <Button Name="SkipButton" Grid.Column="1" Content="O'tkazib yuborish" Style="{StaticResource Btn.Secondary}" Height="44" Margin="0,0,10,0" Click="OnSkipClick" />
        <Button Name="SubmitButton" Grid.Column="2" Content="Javoblarni yuborish" Style="{StaticResource Btn.Primary}" Height="44" MinWidth="220" IsEnabled="False" Click="OnSubmitClick" />
      </Grid>
    </Border>
  </Grid>
</UserControl>