<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ChsbKiosk.ExitPasswordDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Nazoratchi paroli" Width="480" SizeToContent="Height" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" FontFamily="{StaticResource Font.Sans}" UseLayoutRounding="True" Background="#FFFFFFFF" xmlns:chsbkiosk="clr-namespace:ChsbKiosk;assembly=CHSBPlus" Loaded="Window_Loaded">
  <Border BorderBrush="{StaticResource Brush.Primary}" BorderThickness="2" Padding="24">
    <StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
        <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource Brush.PrimarySoft}">
          <Viewbox Width="20" Height="20">
            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Lock}" Stroke="{StaticResource Brush.Primary}" />
          </Viewbox>
        </Border>
        <TextBlock Text="Nazoratchi tasdig'i" Style="{StaticResource Text.Small}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" />
      </StackPanel>
      <TextBlock Name="TitleText" Text="Chiqish paroli" Style="{StaticResource Text.H2}" />
      <PasswordBox Name="PasswordInput" Style="{StaticResource PasswordInput}" Margin="0,16,0,0" MaxLength="128" KeyDown="PasswordInput_KeyDown" />
      <TextBlock Name="ErrorText" Style="{StaticResource Text.Base}" Foreground="{StaticResource Brush.DangerInk}" FontSize="13" Margin="0,8,0,0" Visibility="Collapsed" Text="Parol noto'g'ri." />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
        <Button Content="Bekor qilish" Style="{StaticResource Btn.Secondary}" MinWidth="120" Margin="0,0,10,0" Click="Cancel_Click" />
        <Button Name="ConfirmButton" Content="Chiqish" Style="{StaticResource Btn.Primary}" MinWidth="120" Click="Exit_Click" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>