  <Style x:Key="Icon" TargetType="{x:Type Path}">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Stroke" Value="{StaticResource Brush.Text}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="Shape.StrokeStartLineCap" Value="Round" />
    <Setter Property="Shape.StrokeEndLineCap" Value="Round" />
    <Setter Property="Shape.StrokeLineJoin" Value="Round" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="False" />
  </Style>
  <Style x:Key="Text.Base" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Text.H1" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style x:Key="Text.H2" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="Text.Muted" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Base}">
    <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style x:Key="Text.Small" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Base}">
    <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style x:Key="Text.Label" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style x:Key="Card" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{StaticResource Brush.Card}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Border.CornerRadius" Value="8" />
    <Setter Property="Border.Padding" Value="24" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
  </Style>
  <Style x:Key="Shadow.Sm" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="#FFFFFFFF" />
    <Setter Property="Border.CornerRadius" Value="8" />
    <Setter Property="UIElement.IsHitTestVisible" Value="False" />
    <Setter Property="UIElement.Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#0F172A" Opacity="0.08" />
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Shadow.Xl" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="#FFFFFFFF" />
    <Setter Property="Border.CornerRadius" Value="8" />
    <Setter Property="UIElement.IsHitTestVisible" Value="False" />
    <Setter Property="UIElement.Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="34" ShadowDepth="12" Direction="270" Color="#0F172A" Opacity="0.16" />
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Badge" TargetType="{x:Type Border}">
    <Setter Property="Border.CornerRadius" Value="11" />
    <Setter Property="Border.Padding" Value="10,3" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="#00FFFFFF" />
    <Setter Property="Background" Value="{StaticResource Brush.MutedBg}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
  </Style>
  <Style x:Key="Badge.Outline" TargetType="{x:Type Border}" BasedOn="{StaticResource Badge}">
    <Setter Property="Background" Value="#FFFFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
  </Style>
  <Style x:Key="Badge.Text" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="Btn.Base" TargetType="{x:Type Button}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Root" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Control.Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="UIElement.Opacity" Value="0.9" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="UIElement.Opacity" Value="0.8" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="UIElement.Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Btn.Primary" TargetType="{x:Type Button}" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="{StaticResource Brush.Primary}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Primary}" />
    <Setter Property="Foreground" Value="#FFFFFFFF" />
  </Style>
  <Style x:Key="Btn.Secondary" TargetType="{x:Type Button}" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="#FFFFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
  </Style>
  <Style x:Key="Btn.Soft" TargetType="{x:Type Button}" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="{StaticResource Brush.MutedBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.MutedBg}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Primary}" />
  </Style>
  <Style x:Key="Btn.Danger" TargetType="{x:Type Button}" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="{StaticResource Brush.Danger}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger}" />
    <Setter Property="Foreground" Value="#FFFFFFFF" />
  </Style>
  <Style x:Key="Btn.Success" TargetType="{x:Type Button}" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="{StaticResource Brush.Success}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Success}" />
    <Setter Property="Foreground" Value="#FFFFFFFF" />
  </Style>
  <Style x:Key="Btn.Nav" TargetType="{x:Type Button}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Height" Value="38" />
    <Setter Property="Margin" Value="3" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="{StaticResource Brush.Gray100}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Gray600}" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Root" Background="{TemplateBinding Control.Background}" CornerRadius="8">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="UIElement.Opacity" Value="0.82" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="UIElement.Opacity" Value="0.6" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Input" TargetType="{x:Type TextBox}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="Background" Value="#FFFFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinHeight" Value="44" />
