<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ChsbKiosk.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Test platformasi" Icon="logo.ico" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" FontFamily="{StaticResource Font.Sans}" TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True" Background="#16213C" xmlns:chsbkiosk="clr-namespace:ChsbKiosk;assembly=CHSBPlus" Loaded="Window_Loaded" Deactivated="Window_Deactivated" SourceInitialized="Window_SourceInitialized">
  <Grid Name="Root" Background="{StaticResource Brush.Bg}" HorizontalAlignment="Left" VerticalAlignment="Top">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ContentControl Name="ViewHost" Grid.Row="0" Focusable="False" />
    <Border Grid.Row="1" Background="#FFFFFFFF" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="16,5">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Name="VersionText" Grid.Column="0" Style="{StaticResource Text.Small}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
          <Ellipse Name="ConnectionDot" Width="8" Height="8" Fill="#22C55E" VerticalAlignment="Center" />
          <TextBlock Name="ConnectionText" Text="Serverga ulangan" Style="{StaticResource Text.Small}" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="Chiqish: Ctrl + Q" Style="{StaticResource Text.Small}" HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <Border Name="Splash" Grid.Row="0" Grid.RowSpan="2" Background="{StaticResource Brush.LoginBg}" Visibility="Visible">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="720">
        <Image Source="/Assets/logo-mark.png" Width="132" Height="132" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
        <TextBlock Name="SplashOrganization" Style="{StaticResource Text.Base}" FontSize="17" FontWeight="Medium" Foreground="{StaticResource Brush.Brand}" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,22,0,0" />
        <TextBlock Name="SplashPlatform" Style="{StaticResource Text.Base}" FontSize="38" FontWeight="Bold" Foreground="{StaticResource Brush.Primary}" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,2,0,0" />
        <ProgressBar Name="SplashProgress" IsIndeterminate="True" Width="260" Height="4" Margin="0,30,0,0" Background="#DBE3F0" Foreground="{StaticResource Brush.Primary}" BorderThickness="0" />
        <TextBlock Name="SplashText" Text="Yuklanmoqda..." Style="{StaticResource Text.Base}" FontSize="16" FontWeight="Medium" Margin="0,22,0,0" TextAlignment="Center" HorizontalAlignment="Center" />
        <TextBlock Name="SplashDetail" Style="{StaticResource Text.Muted}" Margin="0,8,0,0" TextAlignment="Center" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</Window>