<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ChsbKiosk.Views.TestsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:ChsbKiosk.Views;assembly=CHSBPlus">
  <Grid Background="{StaticResource Brush.Bg}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#FFFFFFFF" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="28,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Image Grid.Column="0" Source="/Assets/logo-mark-small.png" Width="44" Height="44" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,16,0">
          <TextBlock Name="OrganizationText" Style="{StaticResource Text.Small}" FontWeight="Medium" Foreground="{StaticResource Brush.Brand}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="Test platformasi" Style="{StaticResource Text.H2}" TextWrapping="NoWrap" />
        </StackPanel>
        <Border Grid.Column="2" Background="{StaticResource Brush.Bg}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,12,0" VerticalAlignment="Center" MaxWidth="520">
          <StackPanel Orientation="Horizontal">
            <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource Brush.Primary}" VerticalAlignment="Center">
              <Viewbox Width="16" Height="16">
                <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.User}" Stroke="#FFFFFFFF" />
              </Viewbox>
            </Border>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Name="StudentNameText" Style="{StaticResource Text.Base}" FontWeight="SemiBold" Text="..." TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="440" />
              <TextBlock Name="StudentMetaText" Style="{StaticResource Text.Small}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="440" />
            </StackPanel>
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Name="RefreshButton" Style="{StaticResource Btn.Secondary}" Margin="0,0,8,0" Click="OnRefreshClick">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Refresh}" />
              </Viewbox>
              <TextBlock Text="Yangilash" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Name="LogoutButton" Style="{StaticResource Btn.Secondary}" Click="OnLogoutClick">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.LogOut}" />
              </Viewbox>
              <TextBlock Text="Chiqish" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel MaxWidth="1180" Margin="28,24">
        <TextBlock Text="Faol testlar" Style="{StaticResource Text.H1}" />
        <TextBlock Text="Hozir topshirish mumkin bo'lgan testlar. Boshlash uchun nazoratchi aytgan PIN kod kerak bo'ladi." Style="{StaticResource Text.Muted}" FontSize="14" Margin="0,4,0,18" />
        <Border Name="MessagePanel" Visibility="Collapsed" Background="{StaticResource Brush.DangerSoft}" BorderBrush="{StaticResource Brush.DangerBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
          <TextBlock Name="MessageText" Style="{StaticResource Text.Base}" Foreground="{StaticResource Brush.DangerInk}" />
        </Border>
        <Border Name="SurveyPanel" Visibility="Collapsed" Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="{StaticResource Brush.SuccessSoft}" VerticalAlignment="Center">
              <Viewbox Width="22" Height="22">
                <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Clipboard}" Stroke="{StaticResource Brush.SuccessInk}" />
              </Viewbox>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,16,0">
              <TextBlock Text="So'rovnoma" Style="{StaticResource Text.H2}" />
              <TextBlock Name="SurveyText" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
            </StackPanel>
            <Button Grid.Column="2" Content="Qatnashish" Style="{StaticResource Btn.Primary}" MinWidth="150" Height="44" VerticalAlignment="Center" Click="OnSurveyClick" />
          </Grid>
        </Border>
        <ItemsControl Name="TestsList" Focusable="False" Margin="-8,0,-8,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Card}" Width="372" Margin="8,0,8,16" Padding="22,20" VerticalAlignment="Top">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Text.H2}" Margin="0,0,10,0" Text="{Binding Title}" />
                    <Border Grid.Column="1" Style="{StaticResource Badge}" VerticalAlignment="Top" Margin="0,2,0,0" Background="{Binding BadgeBackground}" Visibility="{Binding BadgeVisibility}">
                      <TextBlock Style="{StaticResource Badge.Text}" Text="{Binding BadgeText}" Foreground="{Binding BadgeForeground}" />
                    </Border>
                  </Grid>
                  <TextBlock Style="{StaticResource Text.Small}" Margin="0,4,0,0" Text="{Binding Description}" />
                  <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                      <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Clock}" Stroke="{StaticResource Brush.Muted}" />
                      </Viewbox>
                      <TextBlock Style="{StaticResource Text.Base}" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding DurationText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.FileText}" Stroke="{StaticResource Brush.Muted}" />
                      </Viewbox>
                      <TextBlock Style="{StaticResource Text.Base}" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding QuestionsText}" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="Fanlar:" Style="{StaticResource Text.Small}" FontWeight="Medium" Margin="0,14,0,4" Visibility="{Binding SubjectsVisibility}" />
                  <ItemsControl Focusable="False" Margin="-3,0,-3,0" ItemsSource="{Binding SubjectList}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource Badge.Outline}" Margin="3">
                          <TextBlock Style="{StaticResource Badge.Text}" FontWeight="Medium" Foreground="{StaticResource Brush.Gray600}" Text="{Binding}" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Style="{StaticResource Text.Small}" Margin="0,10,0,0" Text="{Binding ActiveToText}" Visibility="{Binding ActiveToVisibility}" />
                  <Border BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,12,0,0" Background="{Binding StatusBackground}" BorderBrush="{Binding StatusBorder}" Visibility="{Binding StatusVisibility}">
                    <TextBlock Style="{StaticResource Text.Base}" FontSize="13" FontWeight="Medium" TextAlignment="Center" Text="{Binding Status}" Foreground="{Binding StatusBrush}" />
                  </Border>
                  <Button Style="{StaticResource Btn.Primary}" Height="44" Margin="0,16,0,0" IsEnabled="{Binding CanStart}" Click="OnStartClick">
                    <StackPanel Orientation="Horizontal">
                      <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Play}" Stroke="#FFFFFFFF" />
                      </Viewbox>
                      <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding ButtonText}" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Name="EmptyPanel" Visibility="Collapsed" Style="{StaticResource Card}" Padding="40,48">
          <StackPanel>
            <Viewbox Width="48" Height="48" HorizontalAlignment="Center">
              <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.FileText}" Stroke="{StaticResource Brush.Gray300}" StrokeThickness="1.5" />
            </Viewbox>
            <TextBlock Text="Hozir siz uchun faol test yo'q" Style="{StaticResource Text.H2}" TextAlignment="Center" Margin="0,16,0,0" />
            <TextBlock Style="{StaticResource Text.Muted}" FontSize="14" TextAlignment="Center" Margin="0,6,0,0" Text="Test boshlanish vaqtini kuting. Ro'yxat har 30 soniyada o'zi yangilanadi." />
          </StackPanel>
        </Border>
        <TextBlock Name="UpdatedText" Style="{StaticResource Text.Small}" Margin="2,2,0,0" />
      </StackPanel>
    </ScrollViewer>
    <Grid Name="StartOverlay" Row="0" RowSpan="2" Background="{StaticResource Brush.Overlay}" Visibility="Collapsed">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid Width="680" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,16">
          <Border Style="{StaticResource Shadow.Xl}" />
          <Border Style="{StaticResource Card}" Padding="28,24">
            <StackPanel>
              <TextBlock Name="StartTitle" Style="{StaticResource Text.H2}" FontSize="20" />
              <TextBlock Name="StartMeta" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
              <Border Background="{StaticResource Brush.WarningSoft}" BorderBrush="{StaticResource Brush.WarningBorder}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,16,0,0">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                      <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Alert}" Stroke="{StaticResource Brush.Warning}" />
                    </Viewbox>
                    <TextBlock Text="Test qoidalari — diqqat bilan o'qing" Style="{StaticResource Text.Base}" FontWeight="SemiBold" Foreground="{StaticResource Brush.WarningInk}" Margin="8,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                  <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <TextBlock Name="RulesText" Style="{StaticResource Text.Base}" FontSize="13" LineHeight="20" Foreground="{StaticResource Brush.WarningInk}" />
                  </ScrollViewer>
                </StackPanel>
              </Border>
              <Border Name="CameraPanel" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,12,0,0" Background="{StaticResource Brush.Bg}" BorderBrush="{StaticResource Brush.Border}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Viewbox Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Camera}" Stroke="{StaticResource Brush.Muted}" />
                  </Viewbox>
                  <TextBlock Name="CameraStatusText" Grid.Column="1" Style="{StaticResource Text.Base}" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="CameraRetryButton" Content="Qayta tekshirish" Style="{StaticResource Btn.Secondary}" Height="32" Padding="12,0" FontSize="13" Margin="10,0,0,0" Visibility="Collapsed" Click="OnCameraRetryClick" />
                    <Button Name="CameraWaiveButton" Content="Nazoratchi ruxsati" Style="{StaticResource Btn.Secondary}" Height="32" Padding="12,0" FontSize="13" Margin="8,0,0,0" Visibility="Collapsed" Click="OnCameraWaiveClick" />
                  </StackPanel>
                </Grid>
              </Border>
              <StackPanel Name="PinPanel" Margin="0,16,0,0">
                <TextBlock Text="Test PIN kodi (nazoratchi aytadi)" Style="{StaticResource Text.Label}" />
                <TextBox Name="PinBox" Style="{StaticResource Input}" MaxLength="16" FontSize="20" FontFamily="{StaticResource Font.Mono}" Width="240" HorizontalAlignment="Left" TextChanged="OnStartInputChanged" KeyDown="OnPinKeyDown" />
              </StackPanel>
              <CheckBox Name="ConsentCheck" Style="{StaticResource Check}" Margin="0,16,0,0" Checked="OnConsentChanged" Unchecked="OnConsentChanged">
                <TextBlock Style="{StaticResource Text.Base}" FontWeight="Medium" Text="Qoidalar bilan tanishdim va ularga rioya qilishga roziman" />
              </CheckBox>
              <Border Name="StartErrorPanel" Visibility="Collapsed" Background="{StaticResource Brush.DangerSoft}" BorderBrush="{StaticResource Brush.DangerBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,14,0,0">
                <TextBlock Name="StartErrorText" Style="{StaticResource Text.Base}" Foreground="{StaticResource Brush.DangerInk}" FontSize="13" />
              </Border>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Name="StartCancelButton" Content="Bekor qilish" Style="{StaticResource Btn.Secondary}" Height="44" MinWidth="130" Margin="0,0,10,0" Click="OnStartCancelClick" />
                <Button Name="StartConfirmButton" Content="Testni boshlash" Style="{StaticResource Btn.Primary}" Height="44" MinWidth="220" IsEnabled="False" Click="OnStartConfirmClick" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>