<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ChsbKiosk.Views.LoginView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:ChsbKiosk.Views;assembly=CHSBPlus" Loaded="OnLoaded">
  <Grid Background="{StaticResource Brush.LoginBg}">
    <Grid Width="448" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Border Style="{StaticResource Shadow.Xl}" />
      <Border Style="{StaticResource Card}" Padding="32,30,32,28">
        <StackPanel>
          <Image Source="/Assets/logo-mark.png" Width="84" Height="84" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock Name="OrganizationText" Style="{StaticResource Text.Base}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource Brush.Brand}" TextAlignment="Center" Margin="0,14,0,0" />
          <TextBlock Text="O'quvchi kirish" Style="{StaticResource Text.H1}" TextAlignment="Center" Margin="0,6,0,0" />
          <TextBlock Text="Testlarni topshirish uchun login va parolingizni kiriting" Style="{StaticResource Text.Muted}" FontSize="14" TextAlignment="Center" Margin="0,6,0,22" />
          <Border Name="NoticePanel" Visibility="Collapsed" Background="{StaticResource Brush.WarningSoft}" BorderBrush="{StaticResource Brush.WarningBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
            <TextBlock Name="NoticeText" Style="{StaticResource Text.Base}" Foreground="{StaticResource Brush.WarningInk}" FontSize="13" />
          </Border>
          <Border Name="ErrorPanel" Visibility="Collapsed" Background="{StaticResource Brush.DangerSoft}" BorderBrush="{StaticResource Brush.DangerBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
            <TextBlock Name="ErrorText" Style="{StaticResource Text.Base}" Foreground="{StaticResource Brush.DangerInk}" FontSize="13" />
          </Border>
          <TextBlock Text="Login" Style="{StaticResource Text.Label}" />
          <TextBox Name="UsernameBox" Style="{StaticResource Input}" MaxLength="64" KeyDown="OnInputKeyDown" />
          <TextBlock Text="Parol" Style="{StaticResource Text.Label}" Margin="0,16,0,8" />
          <PasswordBox Name="PasswordInput" Style="{StaticResource PasswordInput}" MaxLength="128" KeyDown="OnInputKeyDown" />
          <Button Name="LoginButton" Content="Kirish" Style="{StaticResource Btn.Primary}" Height="44" Margin="0,20,0,0" Click="OnLoginClick" />
          <TextBlock Style="{StaticResource Text.Muted}" TextAlignment="Center" Margin="0,22,0,0" Text="Muammo bo'lsa, maktabingiz ma'muriga murojaat qiling" />
          <TextBlock Style="{StaticResource Text.Small}" TextAlignment="Center" Margin="0,6,0,0" Text="Bitta login bilan bir vaqtda faqat bitta kompyuterdan kirish mumkin." />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>